# Motion Studio — environment variables
# Copy this file to .env.local and fill in what you need. Every variable is optional
# except ANTHROPIC_API_KEY, which the "Ask Claude" panel requires.

# Anthropic API key (server side only; never sent to the browser).
ANTHROPIC_API_KEY=

# Model used by the Ask Claude panel. Default: claude-opus-5-5
# MOTION_STUDIO_MODEL=claude-opus-5-5

# Browser binary for Export. Auto-detected (Chrome / Edge / Chromium) when empty.
# CHROMIUM_PATH=

# ffmpeg binary for Export. Uses the bundled ffmpeg-static when empty.
# FFMPEG_PATH=

# Where export jobs (frames, status, output) are written.
# Default: <OS temp dir>/motion-studio/jobs
# MOTION_STUDIO_JOBS_DIR=
